# Filled automatically by `shopify app dev`; set these yourself in production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products,read_files,write_files,write_app_proxy

# OpenAI: generates the transparent try-on image from the product photo (server-side only, never sent to the browser)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# local = free background removal (default) · openai = AI redraws the ring from above first
TRYON_GENERATOR=local

# PostgreSQL. Local: `npm run db:up` (Docker) or your own Postgres. Production: your hosted database URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ring_tryon?schema=public
# Optional: a direct (not pooled) URL used only for migrations — set it with a pooled DATABASE_URL (e.g. Neon on Vercel).
# Empty = migrations use DATABASE_URL (laptop, AWS RDS).
DIRECT_URL=

# Optional cap on AI try-on images per 30 days (OpenAI cost). Empty = no limit.
AI_MONTHLY_LIMIT=
# Background image generator. "off" on serverless hosts (Vercel: no always-on process) or when a separate worker runs;
# leave "on" on an always-on server (laptop, AWS EC2 / ECS / Beanstalk).
WORKER=on
