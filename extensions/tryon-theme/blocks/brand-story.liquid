{%- render 'amara-story', s: block.settings, block: block -%}

{% schema %}
{
  "name": "Brand story",
  "target": "section",
  "stylesheet": "configurator.css",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "video_url", "label": "Video URL (optional, .mp4)", "info": "Plays muted on loop instead of the image." },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jewellery for the moments that matter" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We began with one idea: fine jewellery that feels personal. Today we design pieces to be worn every day and kept for generations.</p>" },
    { "type": "header", "content": "Points (optional)" },
    { "type": "text", "id": "point1_title", "label": "Point 1 title" },
    { "type": "text", "id": "point1_text", "label": "Point 1 text" },
    { "type": "text", "id": "point2_title", "label": "Point 2 title" },
    { "type": "text", "id": "point2_text", "label": "Point 2 text" },
    { "type": "text", "id": "point3_title", "label": "Point 3 title" },
    { "type": "text", "id": "point3_text", "label": "Point 3 text" },
    { "type": "header", "content": "Button (optional)" },
    { "type": "text", "id": "button_label", "label": "Label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f3f0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2a2320" }
  ]
}
{% endschema %}
