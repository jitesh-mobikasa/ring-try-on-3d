{%- render 'hamara-story', s: block.settings, block: block -%}

{% schema %}
{
  "name": "Materials",
  "target": "section",
  "stylesheet": "configurator.css",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "video_url", "label": "Video URL (optional, .mp4)", "info": "Plays muted on loop instead of the image." },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "right",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Materials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Precious metals and certified stones" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We use solid 18 ct gold and 950 platinum, with natural or lab-grown diamonds and gemstones that are ethically sourced.</p>" },
    { "type": "header", "content": "Points (optional)" },
    { "type": "text", "id": "point1_title", "label": "Point 1 title", "default": "18 ct gold" },
    { "type": "text", "id": "point1_text", "label": "Point 1 text", "default": "Yellow, white or rose. 75% pure gold, made to last." },
    { "type": "text", "id": "point2_title", "label": "Point 2 title", "default": "Platinum" },
    { "type": "text", "id": "point2_text", "label": "Point 2 text", "default": "Naturally white, dense and hypoallergenic." },
    { "type": "text", "id": "point3_title", "label": "Point 3 title", "default": "Certified stones" },
    { "type": "text", "id": "point3_text", "label": "Point 3 text", "default": "Graded diamonds and traceable gemstones." },
    { "type": "header", "content": "Button (optional)" },
    { "type": "text", "id": "button_label", "label": "Label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f7f3f0" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#2a2320" }
  ]
}
{% endschema %}
