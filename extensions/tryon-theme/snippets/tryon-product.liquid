{%- comment -%}
  One product as JSON for the try-on viewer. "tryon" is the app's metafield (image made by the app).
{%- endcomment -%}
{%- assign t = p.metafields.tryon.asset.value -%}
{
  "productId": {{ p.id }},
  "title": {{ p.title | json }},
  "handle": {{ p.handle | json }},
  "url": {{ shop.url | append: p.url | json }},
  "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 600 | prepend: 'https:' | json }}{% else %}null{% endif %},
  "options": {{ p.options | json }},
  "description": {{ p.description | strip_html | strip | truncate: 600 | json }},
  "type": {{ p.type | json }},
  "images": [{%- for m in p.images limit: 6 -%}{{ m | image_url: width: 800 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "tryon": {% if t and t.image %}{ "kind": {{ t.kind | default: "ring" | json }}, "image": {{ t.image | json }}, "scale": {{ t.scale | default: 1 | json }}, "offsetY": {{ t.offsetY | default: 0 | json }}, "view": {{ t.view | default: "photo" | json }} }{% else %}null{% endif %},
  "variants": [
    {%- for v in p.variants -%}
      { "id": {{ v.id }}, "price": {{ v.price | divided_by: 100.0 }}, "available": {{ v.available | json }}, "options": {{ v.options | json }} }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
