{
  "name": "ring-try-on",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "shopify app dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "deploy": "npm run build:theme && shopify app deploy",
    "config:link": "shopify app config link",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "npm run setup && npm run start",
    "prisma": "prisma",
    "typecheck": "tsc",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d postgres",
    "test:e2e": "node tests/e2e/run.mjs",
    "add-carat": "node tools/add-carat.mjs",
    "demo-catalog": "node tools/demo-catalog.mjs",
    "build:theme": "for f in tryon configurator; do esbuild theme-src/$f.js --minify --target=es2020 --legal-comments=none --log-level=warning --outfile=extensions/tryon-theme/assets/$f.js; done",
    "vercel-build": "prisma generate && DATABASE_URL=${DIRECT_URL:-$DATABASE_URL} prisma migrate deploy && remix vite:build"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/polaris": "^12.27.0",
    "@shopify/shopify-app-remix": "^6.0.6",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.4",
    "isbot": "^5.1.0",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@shopify/cli": "^3.69.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
